# http://editorconfig.org
root = true

# Global baseline
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts
[{*.bats,*.sh,*.bash}]
indent_style = tab
indent_size = 8
switch_case_indent = false
simplify = true

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
